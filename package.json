{
  "name": "companion-memory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A shared, forgetting-aware memory MCP server for AI companions, on Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev --port 8794 --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply companion-memory --local",
    "db:migrate:remote": "wrangler d1 migrations apply companion-memory --remote",
    "seed": "tsx scripts/seed.ts",
    "create-persona": "tsx scripts/create-persona.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261019.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  },
  "license": "MIT"
}
